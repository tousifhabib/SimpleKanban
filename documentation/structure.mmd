flowchart TB
 subgraph Root["🌱 Composition Root"]
        Index("index.js<br>(creates env, renders static DOM, starts app)")
  end
 subgraph Shell["🐚 Imperative Shell — js/app/"]
        App("createApp.js<br>(wiring + refresh loop)")
        BS("boardStore.js<br>(boot → migrate → core + persist)")
        FStore("filterStore.js")
        BC("boardCommands.js<br>(intents → commands)")
        BE("boardEvents.js<br>(event delegation)")
        CDet("cardDetail.js")
        FPan("filterPanel.js")
        GV("ganttView.js")
        DD("dragDrop.js")
        RPk("randomPicker.js")
        Mod("modals.js")
        POpt("pickerOptions.js")
  end
 subgraph Ports["🔌 Ports — js/ports/ (IO-returning adapters)"]
        Env("env.js<br>(capability dictionary + fx edge)")
  end
 subgraph Effects["🎞️ Effect Language — js/effects/"]
        Prog("programs.js<br>(boot / import / export / persist as Free data)")
        BI("browserInterpreter.js")
  end
 subgraph Core["⚙️ Runtimes — js/core/"]
        CS("store.js<br>(pure reducers, coalesced notify, dev freeze)")
        Obs("Observable.js · debounce.js · timers.js")
  end
 subgraph Domain["🧮 Functional Core — js/domain/ (pure, lint-enforced)"]
        Board("board/*<br>(commands · transitions · selectors · lenses · migrate · templates)")
        Filt("filters/*<br>(predicates · transitions · chips)")
        Gantt("gantt/timeline.js")
        Pick("picker/weights.js")
        DragG("drag/geometry.js")
        Dates("dates.js")
        Trans("i18n/translate.js")
  end
 subgraph FP["λ FP Stdlib — js/fp/"]
        Fp("maybe · result · io · task · free · trampoline · transformers<br>lens · match · arrays · memo · freeze · fn")
  end
 subgraph Views["🎨 Pure Views — js/views/ (data, ctx) → DOM"]
        V("board/* · gantt/GanttRenderers · layout/* · modals/*")
  end
 subgraph I18n["🌐 services/i18n"]
        Svc("createI18n + 12 locales")
  end
